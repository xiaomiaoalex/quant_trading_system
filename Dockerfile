# Immutable runtime image.  Both base manifest digests are pinned (multi-arch
# manifest lists, verified 2026-11-04); the release workflow records the final
# application image digest in the release manifest.
#
# pg_dump/pg_restore are required by the backup service.  Copying them from the
# pinned PostgreSQL image avoids a network apt-get during the image build and
# keeps the client version aligned with the database image.
FROM postgres:16@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a AS pgclient

FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

ARG QTS_REVISION=unknown
ARG QTS_VERSION=dev
ARG QTS_SOURCE=https://github.com/xiaomiaoalex/quant_trading_system

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    QTS_REVISION=${QTS_REVISION} \
    QTS_RELEASE_VERSION=${QTS_VERSION}

LABEL org.opencontainers.image.title="quant-trading-system" \
      org.opencontainers.image.revision="${QTS_REVISION}" \
      org.opencontainers.image.version="${QTS_VERSION}" \
      org.opencontainers.image.source="${QTS_SOURCE}" \
      com.qts.revision="${QTS_REVISION}"

# pg_dump/pg_restore and their runtime libraries come from the pinned
# PostgreSQL stage; no Docker socket is mounted, so tooling runs inside the
# application image.
COPY --from=pgclient /usr/lib/postgresql/16 /usr/lib/postgresql/16
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libpq.so.5 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libgssapi_krb5.so.2 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libkrb5.so.3 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libk5crypto.so.3 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libcom_err.so.2 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libkrb5support.so.0 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libldap.so.2 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/liblber.so.2 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libsasl2.so.2 /usr/lib/x86_64-linux-gnu/
COPY --from=pgclient /usr/lib/x86_64-linux-gnu/libkeyutils.so.1 /usr/lib/x86_64-linux-gnu/
ENV PATH="/usr/lib/postgresql/16/bin:${PATH}"

WORKDIR /app
COPY trader/requirements-runtime.txt trader/requirements-runtime.txt
COPY trader/requirements-runtime.constraints.txt trader/requirements-runtime.constraints.txt
# Hashes are generated by `uv pip compile --generate-hashes` for
# x86_64-unknown-linux-gnu / CPython 3.12; see the file header and
# docs/CI_CD_IMPROVEMENT_RFC.md.
RUN pip install --no-cache-dir --retries 10 --timeout 120 --require-hashes \
    -r trader/requirements-runtime.constraints.txt

COPY . .
RUN useradd --create-home --uid 10001 qts \
    && mkdir -p /var/lib/qts \
    && chown -R qts:qts /app /var/lib/qts

USER qts
