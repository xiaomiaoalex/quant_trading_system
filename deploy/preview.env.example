# Branch preview environment (NON-SECRET example).
#
# Copy this file to an untracked location OUTSIDE the repository tree (for
# example /opt/qts-preview/preview.env or app/preview.env on the preview host)
# and fill every REPLACE_WITH_* value.  Only deploy/preview.env.example is
# tracked; the filled file is never committed and never copied into the
# repository.
#
# This file intentionally contains no usable credentials, no default password
# and no placeholder that would pass as a real secret.  The validator
# (scripts/validate_preview_env.py) refuses placeholder values, so a preview
# that was started with an unfilled file cannot come up.
#
# The preview is a trial entry point for this branch.  It is not a release:
# it produces no release evidence, no observation window and no DR proof.
#
# Validate before starting:
#   python scripts/validate_preview_env.py --env-file <preview.env> --check-images
#
# Start (from the repository root on the preview host):
#   docker compose -f compose.yml -f deploy/compose.preview.yml \
#     --env-file <preview.env> up -d

# --- identity / isolation -------------------------------------------------
QTS_PREVIEW_COMPOSE_PROJECT=qts-branch-preview
QTS_PREVIEW_ID=REPLACE_WITH_PREVIEW_ID
QTS_PREVIEW_COMMIT=REPLACE_WITH_40_CHAR_COMMIT
QTS_PREVIEW_USERNAME=owner

# --- published ports ------------------------------------------------------
# The gateway is published on the loopback interface only.  Reach it from a
# workstation through a strict SSH tunnel:
#   ssh -o BatchMode=yes -o StrictHostKeyChecking=yes \
#     -L 18080:127.0.0.1:18080 alex@192.168.0.105
# and open http://127.0.0.1:18080/.
QTS_PREVIEW_HTTP_PORT=18080
QTS_PREVIEW_ALERT_PORT=18085
# The browser origin the Control API accepts.  It must match the URL the
# browser uses, because the session cookie is only allowed to be non-secure
# for a loopback origin.
QTS_PREVIEW_ORIGIN=http://127.0.0.1:18080

# --- immutable artifacts ---------------------------------------------------
# The runtime image is built once on a host with Docker and transferred; the
# preview host never builds and never pulls.  Record the actual image id so
# the preview is bound to one concrete build: the validator compares it with
# the image the host actually has.
QTS_PREVIEW_RUNTIME_IMAGE=qts-runtime:preview-REPLACE_WITH_TAG
QTS_PREVIEW_RUNTIME_IMAGE_ID=sha256:REPLACE_WITH_64_HEX
QTS_PREVIEW_UI_IMAGE=qts-preview-ui:REPLACE_WITH_TAG
# The PostgreSQL image is not configurable here: deploy/compose.preview.yml
# pins postgres:16@sha256:5db6dac2... so the preview cannot drift away from
# the reviewed database image.

# --- credentials (generated per deployment, never committed) ---------------
# Generate a random database password, for example:
#   python -c "import secrets; print('pg_' + secrets.token_urlsafe(24))"
QTS_PREVIEW_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_RANDOM_PASSWORD
# Generate the owner password hash on the preview host, for example:
#   docker run --rm -it qts-runtime:preview-<tag> python -m trader.api.auth
# The result looks like scrypt$<32 hex salt>$<128 hex digest>.
#
# The value MUST be wrapped in single quotes.  Compose interpolates $NAME in an
# unquoted (or double-quoted) dotenv value, which silently truncates the hash to
# "scrypt" and makes every login fail.  Single quotes keep it literal; escaping
# every $ as $$ also works.  Never deploy the unquoted form.
QTS_PREVIEW_PASSWORD_HASH='REPLACE_WITH_GENERATED_SCRYPT_HASH'
