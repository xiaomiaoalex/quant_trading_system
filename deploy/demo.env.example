# Binance Spot Demo release environment (NON-SECRET example).
#
# Copy to a controlled, untracked file and fill every REPLACE_WITH_* value from
# the secret manager or the release manifest.  This file intentionally contains
# no usable credentials, and scripts/deploy_preflight.py rejects placeholder
# values, default passwords and mutable image tags.
#
# Run:
#   python scripts/deploy_preflight.py \
#     --env-file deploy/demo.env \
#     --release-manifest artifacts/cicd/release-manifest.json
#
# Never commit the filled file.  The release workflow passes it through the
# protected environment; it is not stored in the repository.

# --- identity / isolation -------------------------------------------------
QTS_COMPOSE_PROJECT=qts_demo_REPLACE_WITH_RELEASE_SLOT
QTS_DEMO_PG_PORT=65432
QTS_DEMO_CONTROL_PORT=18090
QTS_DEMO_ALERT_PORT=18085

# --- immutable artifacts ---------------------------------------------------
# Both digests must come from the verified release manifest.
QTS_RELEASE_ID=REPLACE_WITH_RELEASE_ID
QTS_RELEASE_COMMIT=REPLACE_WITH_40_CHAR_COMMIT
QTS_RELEASE_IMAGE=ghcr.io/REPLACE_WITH_OWNER/quant-trading-system@sha256:REPLACE_WITH_64_HEX
QTS_EXPECTED_DIGEST=sha256:REPLACE_WITH_64_HEX
QTS_PREVIOUS_IMAGE_DIGEST=sha256:REPLACE_WITH_PREVIOUS_64_HEX
QTS_POSTGRES_IMAGE=postgres:16@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a
QTS_ALERT_IMAGE=python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# --- exchange / account ----------------------------------------------------
# Hard-coded again in deploy/compose.demo.yml; kept here for preflight clarity.
BINANCE_ENV=demo
QTS_ACCOUNT_ID=binance_spot_demo
QTS_SYMBOLS=BTCUSDT,ETHUSDT
QTS_INSTRUMENTS={"BTCUSDT":["BTC","USDT"],"ETHUSDT":["ETH","USDT"]}
QTS_STRATEGY_MODULE=REPLACE_WITH_APPROVED_STRATEGY_MODULE
QTS_STRATEGY_WARMUP_EVENTS=200
QTS_RECONCILE_INTERVAL_SECONDS=30

# --- credentials (values injected by the secret manager, never committed) --
# Control API: no exchange credentials.  Execution uses mounted secret files.
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_PASSWORD
QTS_AUTH_REQUIRED=1
QTS_USERNAME=owner
QTS_PASSWORD_HASH=REPLACE_WITH_SECRET_MANAGER_BCRYPT_HASH
QTS_ALERT_SIGNING_SECRET=REPLACE_WITH_SECRET_MANAGER_ALERT_SECRET
BINANCE_API_KEY_FILE_PATH=/run/secrets/binance_api_key
BINANCE_SECRET_KEY_FILE_PATH=/run/secrets/binance_secret_key

# --- alerting / DR ---------------------------------------------------------
# External alert acknowledgement path; must not be the in-cluster alert-sink.
QTS_EXTERNAL_ALERT_WEBHOOK_URL=https://alerts.example.com/qts
QTS_EXTERNAL_ALERT_HEARTBEAT_URL=https://alerts.example.com/qts/heartbeat
QTS_DR_REQUIRED=1
QTS_DR_EVIDENCE_PATH=/var/lib/qts/dr/dr-evidence.json
QTS_DR_EVIDENCE_DIR=/srv/qts-demo/dr-evidence
QTS_BACKUP_RPO_SECONDS=300
QTS_BACKUP_OFF_HOST_ATTESTED=1
QTS_BACKUP_ATTESTED_BY=REPLACE_WITH_OPERATOR_NAME

# --- schema / rollback compatibility --------------------------------------
QTS_SCHEMA_VERSION=3
QTS_SCHEMA_COMPAT_EVIDENCE_PATH=/srv/qts-demo/evidence/schema-compat.json
QTS_ROLLBACK_COMPAT_EVIDENCE_PATH=/srv/qts-demo/evidence/rollback-compat.json
